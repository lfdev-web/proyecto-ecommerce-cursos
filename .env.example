# Django
DJANGO_SECRET_KEY=django-insecure-example-key-replace-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# En producción: dominio real del frontend (ej. https://miapp.com). En dev no se usa (DEBUG=True permite todos los orígenes).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL 17
POSTGRES_DB=ecommerce_cursos_db
POSTGRES_USER=ecommerce_user
POSTGRES_PASSWORD=dev_postgres_password_123
POSTGRES_HOST=postgres_db
POSTGRES_PORT=5432
# Password del rol de solo lectura usado por integraciones de analítica externas (ej. Power BI)
POWERBI_READONLY_PASSWORD=dev_powerbi_password_123

# Redis
REDIS_PASSWORD=dev_redis_password_123
REDIS_URL=redis://:dev_redis_password_123@redis:6379/0

# Celery
CELERY_BROKER_URL=redis://:dev_redis_password_123@redis:6379/0
CELERY_RESULT_BACKEND=redis://:dev_redis_password_123@redis:6379/1

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Solo producción (DEBUG=False) — ver DESPLIEGUE.md
# Cuántos proxies propios hay delante de Django. Con nginx del compose de
# producción es 1. Con 0 se ignora X-Forwarded-For (que el cliente puede
# falsificar) y se usa REMOTE_ADDR.
TRUSTED_PROXY_COUNT=1
# HSTS en segundos. Arranca en 3600 (1 hora) para poder revertir rápido si algo
# sale mal; súbelo a 31536000 (1 año) cuando el HTTPS esté probado y estable.
SECURE_HSTS_SECONDS=3600
# Opcional: si no se define, la caché usa REDIS_URL cambiándole la base a /2.
# CACHE_URL=redis://:PASSWORD@redis:6379/2
