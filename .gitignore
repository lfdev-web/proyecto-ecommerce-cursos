# Respaldos de la base de datos
# Un dump contiene los datos reales: emails, hashes de contraseña e IPs de
# acceso de todos los usuarios. No debe versionarse.
respaldos/
*.sql.gz
*.dump
# dumpdata de Django: además de los datos, arrastra sessions.session con el
# session_data de cada usuario. Nunca al repositorio.
respaldo_*.json
*_dump.json

